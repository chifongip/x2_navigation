# Uses the fixed retreat profile configured on the server.
---
uint16 SUCCESS=0
uint16 BUSY=1
uint16 INVALID_STATE=2
uint16 NAVIGATION_ACTIVE=3
uint16 ODOMETRY_UNAVAILABLE=4
uint16 COLLISION_STOPPED=5
uint16 UNDOCK_TIMEOUT=6
uint16 SAFETY_ABORT=7
uint16 CANCELED=8
bool success
uint16 error_code
string message
float64 distance_traveled
uint8 manipulation_state
---
uint16 VALIDATING=0
uint16 MOVING=1
uint16 SETTLING=2
uint16 stage
float64 distance_traveled
float64 distance_remaining
float64 commanded_speed
float64 commanded_lateral_speed
float64 commanded_yaw_speed
float32 progress
