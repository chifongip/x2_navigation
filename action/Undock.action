# Empty selection uses the last successful dock, or the default after restart.
string profile_id
---
uint16 SUCCESS=0
uint16 BUSY=1
uint16 INVALID_STATE=2
uint16 NAVIGATION_ACTIVE=3
uint16 NO_STABLE_TAG=4
uint16 COLLISION_STOPPED=5
uint16 UNDOCK_TIMEOUT=6
uint16 SAFETY_ABORT=7
uint16 CANCELED=8
uint16 INVALID_PROFILE=9
bool success
uint16 error_code
string message
float64 distance_traveled
uint8 manipulation_state
string profile_id
# Resolved profile mode. Timed distances are command-based estimates.
string undock_mode
float64 elapsed_time
string instance_id
---
uint16 VALIDATING=0
uint16 MOVING=1
uint16 SETTLING=2
uint16 stage
float64 distance_traveled
float64 distance_remaining
float64 commanded_speed
float64 commanded_lateral_speed
float64 commanded_yaw_speed
float32 progress
string profile_id
string undock_mode
float64 elapsed_time
string instance_id
