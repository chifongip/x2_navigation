# Empty selection uses the selected box's default, or default_docking_profile
# without an instance_id. execute defaults to false.
bool execute
string profile_id
# Required for a box target profile; use the selected BoxState instance_id.
string instance_id
---
uint16 SUCCESS=0
uint16 BUSY=1
uint16 INVALID_STATE=2
uint16 NAVIGATION_ACTIVE=3
uint16 NO_STABLE_TAG=4
uint16 OUTSIDE_CAPTURE_ENVELOPE=5
uint16 DOCKING_FAILED=6
uint16 COLLISION_STOPPED=7
uint16 ALIGNMENT_TIMEOUT=8
uint16 SAFETY_ABORT=9
uint16 INVALID_PROFILE=10
bool success
uint16 error_code
string message
geometry_msgs/Pose2D final_error
uint8 manipulation_state
string profile_id
string instance_id
---
uint16 VALIDATING=0
uint16 ACQUIRING=1
uint16 CONTROLLING=2
uint16 REACQUIRING=3
uint16 SETTLING=4
uint16 stage
geometry_msgs/Pose2D current_error
bool tag_visible
float32 progress
string profile_id
string instance_id
